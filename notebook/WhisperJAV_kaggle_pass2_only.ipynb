   "source": [
    "#@title Step 3: Parallel Execution (Pass 2 Only) { display-mode: \"form\" }\n",
    "#@markdown - Auto-detects **Files** (Kaggle Dataset or Colab Drive).\n",
    "#@markdown - Auto-detects **Parallel** (2x GPU, each processes different file) or **Sequential** mode.\n",
    "#@markdown - Runs **Pass 2 ONLY** for each file.\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "import sys\n",
    "import time\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from IPython.display import HTML, FileLink, display\n",
    "\n",
    "\n",
    "def format_pass_error(log: str, tail_chars: int = 1500) -> str:\n",
    "    \"\"\"Show the END of the failed-pass log so users see the actual exception/traceback.\n",
    "    If the log is short, show all of it; otherwise show the last tail_chars characters.\n",
    "    \"\"\"\n",
    "    if not log:\n",
    "        return \"    (no log captured)\"\n",
    "    log = log.rstrip()\n",
    "    if len(log) <= tail_chars:\n",
    "        excerpt = log\n",
    "    else:\n",
    "        excerpt = \"...(earlier output truncated)...\\n\" + log[-tail_chars:]\n",
    "    # Indent each line for readability\n",
    "    return \"\\n\".join(\"      \" + line for line in excerpt.splitlines())\n",
    "\n",
    "\n",
    "# ═══════════════════════════════════════════\n",
    "# PLATFORM SETUP\n",
    "# ═══════════════════════════════════════════\n",
    "\n",
    "if \"WHISPERJAV_CONFIG\" not in globals():\n",
    "    raise RuntimeError(\"Run Step 1 first!\")\n",
    "\n",
    "cfg = WHISPERJAV_CONFIG\n",
    "PLATFORM = cfg['platform']\n",
    "\n",
    "# Define Paths based on Platform\n",
    "if PLATFORM == \"kaggle\":\n",
    "    INPUT_DIR = Path(\"/kaggle/input\")\n",
    "    OUTPUT_DIR = Path(\"/kaggle/working/output\")\n",
    "    TEMP_DIR = Path(\"/tmp/whisperjav\")\n",
    "    # Find dataset folder (usually first subdir in input)\n",
    "    try:\n",
    "        DATASET_DIR = next(d for d in INPUT_DIR.iterdir() if d.is_dir())\n",
    "    except StopIteration:\n",
    "        DATASET_DIR = INPUT_DIR\n",
    "elif PLATFORM == \"colab\":\n",
    "    INPUT_DIR = Path(f\"/content/drive/MyDrive/{cfg['folder_name']}\")\n",
    "    OUTPUT_DIR = INPUT_DIR  # Output in same folder\n",
    "    TEMP_DIR = Path(\"/content/temp\")\n",
    "    DATASET_DIR = INPUT_DIR\n",
    "else:\n",
    "    # Local fallback\n",
    "    INPUT_DIR = Path(\"./\")\n",
    "    OUTPUT_DIR = Path(\"./output\")\n",
    "    TEMP_DIR = Path(\"./temp\")\n",
    "    DATASET_DIR = INPUT_DIR\n",
    "\n",
    "# Create dirs\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "TEMP_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ═══════════════════════════════════════════\n",
    "# FILE SCANNING\n",
    "# ═══════════════════════════════════════════\n",
    "print(f\"Scanning {DATASET_DIR}...\")\n",
    "VIDEO_EXTS = {'.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv', '.webm', '.m4v', '.mp3', '.wav', '.flac', '.m4a'}\n",
    "videos = [f for f in DATASET_DIR.rglob(\"*\") if f.suffix.lower() in VIDEO_EXTS]\n",
    "\n",
    "if not videos:\n",
    "    print(f\"No media files found in {DATASET_DIR}\")\n",
    "else:\n",
    "    print(f\"Found {len(videos)} files\")\n",
    "\n",
    "# ═══════════════════════════════════════════\n",
    "# GPU SETUP\n",
    "# ═══════════════════════════════════════════\n",
    "import torch\n",
    "ngpus = torch.cuda.device_count()\n",
    "print(f\"GPUs Available: {ngpus}\")\n",
    "\n",
    "if ngpus >= 2:\n",
    "    MODE = \"PARALLEL\"\n",
    "    MAX_WORKERS = 2\n",
    "else:\n",
    "    MODE = \"SEQUENTIAL\"\n",
    "    MAX_WORKERS = 1\n",
    "\n",
    "print(f\"Mode: {MODE} (Pass 2 Only, {MAX_WORKERS} worker(s))\")\n",
    "\n",
    "# ═══════════════════════════════════════════\n",
    "# EXECUTION ENGINE (Pass 2 Only)\n",
    "# ═══════════════════════════════════════════\n",
    "\n",
    "def build_cmd_pass2(video_path, output_dir, gpu_id):\n",
    "    \"\"\"Build CLI command for Pass 2 transcription (single-pass mode).\n",
    "    \n",
    "    This notebook runs ONLY Pass 2, processing different files on different GPUs.\n",
    "    \"\"\"\n",
    "    # Unique temp dir for this file's Pass 2\n",
    "    pass_temp = TEMP_DIR / f\"p2_{video_path.stem}\"\n",
    "    pass_temp.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    # Output dir (no \"pass2\" subdirectory since only pass 2 exists)\n",
    "    pass_out = output_dir / \"pass2\"\n",
    "    pass_out.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    # Base command\n",
    "    executable = cfg.get('whisperjav_cmd', sys.executable + \" -m whisperjav.main\")\n",
    "    # Handle direct path or python module invocation\n",
    "    if str(executable).endswith('whisperjav'):\n",
    "        cmd = [str(executable)]\n",
    "    else:\n",
    "        cmd = list(str(executable).split())  # e.g. \"python -m whisperjav.main\"\n",
    "\n",
    "    cmd += [\n",
    "        str(video_path),\n",
    "        \"--output-dir\", str(pass_out),\n",
    "        \"--temp-dir\", str(pass_temp),\n",
    "        \"--keep-temp\",\n",
    "        \"--mode\", cfg['pass2_pipeline'],\n",
    "        \"--sensitivity\", cfg['pass2_sensitivity'],\n",
    "        \"--subs-language\", \"direct-to-english\" if cfg['subtitle_language'] == 'direct-to-english' else \"native\",\n",
    "    ]\n",
    "\n",
    "    # Model\n",
    "    model = cfg['pass2_model']\n",
    "    if model:\n",
    "        cmd += [\"--model\", model]\n",
    "\n",
    "    # Speech segmenter (valid single-pass arg)\n",
    "    seg = cfg.get('pass2_speech_segmenter')\n",
    "    if seg and seg != 'none':\n",
    "        cmd += [\"--speech-segmenter\", seg]\n",
    "\n",
    "    # Scene detection method (valid single-pass arg)\n",
    "    scene = cfg.get('pass2_scene_detector')\n",
    "    if scene and scene != 'none':\n",
    "        cmd += [\"--scene-detection-method\", scene]\n",
    "\n",
    "    return cmd, pass_out\n",
    "\n",
    "def run_pass2(video_idx, video, gpu_id):\n",
    "    \"\"\"Run Pass 2 only on a single file with specified GPU.\"\"\"\n",
    "    cmd, out_dir = build_cmd_pass2(video, OUTPUT_DIR, gpu_id)\n",
    "    \n",
    "    env = os.environ.copy()\n",
    "    env[\"CUDA_VISIBLE_DEVICES\"] = str(gpu_id)\n",
    "    \n",
    "    t0 = time.time()\n",
    "    # Timeout: 2 hours per file\n",
    "    try:\n",
    "        proc = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=7200)\n",
    "        success = proc.returncode == 0\n",
    "    except subprocess.TimeoutExpired:\n",
    "        proc = subprocess.CompletedProcess(cmd, 1, stdout=\"\", stderr=\"Timeout expired\")\n",
    "        success = False\n",
    "    \n",
    "    # Check output: WhisperJAV 1.8+ naming: {stem}.{lang}.whisperjav.srt\n",
    "    found_srt = list((out_dir).glob(f\"{video.stem}*.srt\"))\n",
    "    result_srt = found_srt[0] if found_srt else None\n",
    "    \n",
    "    return {\n",
    "        \"idx\": video_idx,\n",
    "        \"file\": video.name,\n",
    "        \"success\": success and (result_srt is not None),\n",
    "        \"srt\": result_srt,\n",
    "        \"time\": time.time() - t0,\n",
    "        \"log\": proc.stderr[-1000:] if proc.stderr else \"\"\n",
    "    }\n",
    "\n",
    "# ═══════════════════════════════════════════\n",
    "# MAIN LOOP - FILE-LEVEL PARALLELISM\n",
    "# ═══════════════════════════════════════════\n",
    "\n",
    "WHISPERJAV_RESULTS = []\n",
    "\n",
    "if MODE == \"PARALLEL\" and len(videos) > 1:\n",
    "    print(f\"\\nStarting parallel transcription (2x GPU, Pass 2 only)...\\n\")\n",
    "    \n",
    "    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n",
    "        futures = {}\n",
    "        gpu_id_cycle = 0\n",
    "        \n",
    "        # Submit all tasks, cycling through GPUs\n",
    "        for i, video in enumerate(videos):\n",
    "            gpu_id = gpu_id_cycle % ngpus\n",
    "            future = executor.submit(run_pass2, i, video, gpu_id)\n",
    "            futures[future] = (i, video.name, gpu_id)\n",
    "            gpu_id_cycle += 1\n",
    "        \n",
    "        # Process results as they complete\n",
    "        for future in as_completed(futures):\n",
    "            video_idx, video_name, assigned_gpu = futures[future]\n",
    "            result = future.result()\n",
    "            \n",
    "            print(f\"[{video_idx+1}/{len(videos)}] {video_name} (GPU {assigned_gpu})\")\n",
    "            print(f\"  Time: {result['time']:.0f}s | Status: {'OK' if result['success'] else 'FAIL'}\")\n",
    "            \n",
    "            if result['success']:\n",
    "                # Move SRT to output root\n",
    "                final_srt = OUTPUT_DIR / result['srt'].name\n",
    "                shutil.copy(result['srt'], final_srt)\n",
    "                print(f\"  Output: {final_srt.name}\")\n",
    "                WHISPERJAV_RESULTS.append(final_srt)\n",
    "            else:\n",
    "                print(f\"  Error (last 800 chars):\\n{format_pass_error(result['log'], 800)}\")\nelse:\n",
    "    # Sequential fallback\n",
    "    print(f\"\\nStarting sequential transcription (Pass 2 only)...\\n\")\n",
    "    \n",
    "    for i, video in enumerate(videos):\n",
    "        result = run_pass2(i, video, 0)\n",
    "        \n",
    "        print(f\"[{i+1}/{len(videos)}] {video.name}\")\n",
    "        print(f\"  Time: {result['time']:.0f}s | Status: {'OK' if result['success'] else 'FAIL'}\")\n",
    "        \n",
    "        if result['success']:\n",
    "            # Move SRT to output root\n",
    "            final_srt = OUTPUT_DIR / result['srt'].name\n",
    "            shutil.copy(result['srt'], final_srt)\n",
    "            print(f\"  Output: {final_srt.name}\")\n",
    "            WHISPERJAV_RESULTS.append(final_srt)\n",
    "        else:\n",
    "            print(f\"  Error (last 800 chars):\\n{format_pass_error(result['log'], 800)}\")\n",
    "\nprint(\"\\n\" + \"=\"*50)\nprint(f\"DONE! Processed {len(WHISPERJAV_RESULTS)}/{len(videos)} files successfully.\")\nprint(\"=\"*50)\n\nif PLATFORM == \"kaggle\":\n",
    "    # Zip output for easy download\n",
    "    shutil.make_archive(\"/kaggle/working/subtitles\", 'zip', OUTPUT_DIR)\n",
    "    print(\"\\nOutput zipped: subtitles.zip\")"
   ]
  }
